# Runtime chỉ trên loopback; cài lần đầu cần Internet, dùng sau đó local.
DBOT_PORT=8008
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=dbot-qwen35:4b
OLLAMA_CONTEXT=4096
MODEL_TIMEOUT=600
OFFLINE_MODE=1
SAVE_HISTORY=1
MAX_UPLOAD_MB=12
# Để trống bằng cách comment, mặc định data/ bên cạnh source.
# DBOT_DATA_DIR=F:\D-bot-data
# STT_MODEL_PATH=F:\D-bot-data\models\whisper-base
# STT_LEARNING_MODEL_PATH=F:\D-bot-data\models\whisper-small
# TTS_VOICE_PATH=F:\D-bot-data\models\vi_VN-vais1000-medium.onnx
# Audio: xử lý tạm, không có chế độ giữ raw audio trong V1.
# Worker nặng: tối đa 1. Index: tối đa 5 job trong hàng đợi, 45s/file.
# OLLAMA_NO_CLOUD=1 được launcher truyền cho PROCESS Ollama; .env này không đủ.
